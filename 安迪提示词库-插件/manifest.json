{
  "manifest_version": 3,
  "name": "安迪提示词库",
  "version": "1.1.5",
  "minimum_chrome_version": "116",
  "description": "高频提示词库：网页输入框打 // 直接选用，{{变量}} 填空，Ctrl+S 存入库，侧边栏按使用频率排序，数据存在浏览器本地。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "安迪提示词库（点击打开侧边栏）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "clipboardWrite", "scripting", "contextMenus", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["vars.js", "content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P" },
      "description": "打开提示词库侧边栏"
    }
  }
}
